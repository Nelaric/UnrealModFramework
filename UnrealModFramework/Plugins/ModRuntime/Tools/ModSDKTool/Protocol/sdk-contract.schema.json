{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UMF resolved SDK contract v2",
  "type": "object",
  "required": ["format", "schemaVersion", "status", "unresolvedTypeCount", "gameId", "adapterABI", "contractHash", "projectionHash", "nativeABIHash", "types", "apis"],
  "properties": {
    "format": { "const": "UMF.SdkContract" },
    "schemaVersion": { "const": 2 },
    "status": { "const": "Complete" },
    "unresolvedTypeCount": { "const": 0 },
    "gameId": { "type": "string", "minLength": 1 },
    "adapterABI": { "const": "ContextHandlesV1" },
    "contractHash": { "$ref": "#/$defs/hash" },
    "projectionHash": { "$ref": "#/$defs/hash" },
    "nativeABIHash": { "$ref": "#/$defs/hash" },
    "connectionDescriptor": { "type": "string", "minLength": 1, "description": "Optional public UMF.ClientABI artifact path relative to the generated root and published bundle/plugin root." },
    "errorCodeEncodingVersion": { "const": 2 },
    "errorHeader": { "type": "string", "minLength": 1, "description": "Public header containing the SDK's structured error code macros." },
    "modLifecycle": {
      "type": "object",
      "required": ["schemaVersion", "module", "resource", "resourceHash"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "module": { "const": "ModLoader" },
        "resource": { "const": "Contract/ModLifecycle.json" },
        "resourceHash": { "$ref": "#/$defs/hash" }
      }
    },
    "types": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "required": ["id", "kind", "cppName"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "const": "ObjectReference" },
          "cppName": { "type": "string", "pattern": "^F[A-Za-z0-9_]+$" },
          "view": { "const": "Full" }
        }
      }
    },
    "apis": {
      "type": "array", "minItems": 1, "maxItems": 1024,
      "items": {
        "type": "object",
        "required": ["id", "name", "displayName", "shape", "scope", "thread", "failureRule", "permissions", "signatureHash", "projectionHash", "native"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "$ref": "#/$defs/identifier" },
          "displayName": { "type": "string", "minLength": 1 },
          "shape": { "enum": ["ObjectGetter", "FloatMethod", "TypedMethod"] },
          "scope": { "enum": ["Player", "World"] },
          "thread": { "const": "GameThread" },
          "failureRule": { "const": "ReturnError" },
          "sourceErrorCodes": {
            "description": "Source analysis metadata for failure paths in the original implementation.",
            "type": "object",
            "propertyNames": { "minLength": 1 },
            "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
          },
          "permissions": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "signatureHash": { "$ref": "#/$defs/hash" },
          "projectionHash": { "$ref": "#/$defs/hash" },
          "resultTypeId": { "type": "string", "minLength": 1 },
          "targetTypeId": { "type": "string", "minLength": 1 },
          "provider": { "const": "LocalPlayerSubsystem" },
          "nullResult": { "const": "Error" },
          "parameterName": { "$ref": "#/$defs/identifier" },
          "parameterId": { "type": "string", "minLength": 1 },
          "blueprint": { "type": "boolean" },
          "hostBlueprint": {
            "type": "object", "required": ["callingTableHash"], "additionalProperties": false,
            "properties": { "callingTableHash": { "$ref": "#/$defs/hash" } }
          },
          "parameters": {
            "type": "array", "maxItems": 64,
            "items": {
              "oneOf": [
                { "$ref": "#/$defs/scalar" },
                {
                  "type": "object", "required": ["kind", "class", "const", "include", "module"],
                  "properties": {
                    "kind": { "const": "ObjectInput" },
                    "class": { "$ref": "#/$defs/identifier" },
                    "const": { "type": "boolean" },
                    "include": { "type": "string", "minLength": 1 },
                    "module": { "$ref": "#/$defs/identifier" }
                  }
                }
              ]
            }
          },
          "result": {
            "oneOf": [
              { "$ref": "#/$defs/scalar" },
              { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "Void" } } },
              {
                "type": "object", "required": ["kind", "typeId"],
                "properties": { "kind": { "const": "ObjectReference" }, "typeId": { "type": "string", "minLength": 1 } }
              }
            ]
          },
          "native": {
            "type": "object", "required": ["header", "symbol"],
            "properties": {
              "header": { "type": "string", "minLength": 1 },
              "symbol": { "$ref": "#/$defs/identifier" }
            }
          }
        },
        "allOf": [
          { "if": { "properties": { "shape": { "const": "ObjectGetter" } } }, "then": { "required": ["resultTypeId", "provider", "nullResult"], "properties": { "scope": { "const": "Player" } } } },
          { "if": { "properties": { "shape": { "const": "FloatMethod" } } }, "then": { "required": ["targetTypeId", "parameterName", "parameterId"] } },
          {
            "if": { "required": ["hostBlueprint"] },
            "then": {
              "required": ["targetTypeId"],
              "properties": { "scope": { "const": "World" }, "shape": { "const": "TypedMethod" } },
              "not": { "required": ["provider"] }
            }
          },
          {
            "if": { "properties": { "shape": { "const": "TypedMethod" } } },
            "then": {
              "required": ["parameters", "result", "blueprint"],
              "oneOf": [
                { "required": ["targetTypeId"] },
                { "required": ["provider"], "properties": { "scope": { "const": "Player" } } }
              ]
            }
          }
        ]
      }
    }
  },
  "dependentRequired": {
    "errorCodeEncodingVersion": ["errorHeader", "connectionDescriptor"],
    "errorHeader": ["errorCodeEncodingVersion"]
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$" },
    "scalar": {
      "type": "object", "required": ["kind", "cppType"],
      "properties": {
        "kind": { "const": "Scalar" },
        "cppType": { "enum": ["bool", "float", "double", "int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64"] }
      }
    }
  }
}
