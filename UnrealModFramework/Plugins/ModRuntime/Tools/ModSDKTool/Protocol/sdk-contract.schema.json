{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UMF resolved SDK contract v1",
  "type": "object",
  "required": ["format", "schemaVersion", "status", "unresolvedTypeCount", "gameId", "adapterAbi", "contractHash", "projectionHash", "nativeAbiHash", "types", "apis"],
  "properties": {
    "format": { "const": "UMF.SdkContract" },
    "schemaVersion": { "const": 1 },
    "status": { "const": "Complete" },
    "unresolvedTypeCount": { "const": 0 },
    "gameId": { "type": "string", "minLength": 1 },
    "adapterAbi": { "const": "ContextHandlesV1" },
    "contractHash": { "$ref": "#/$defs/hash" },
    "projectionHash": { "$ref": "#/$defs/hash" },
    "nativeAbiHash": { "$ref": "#/$defs/hash" },
    "connectionDescriptor": { "type": "string", "minLength": 1, "description": "Optional public UMF.ClientAbi artifact path relative to the generated root and published bundle/plugin root." },
    "types": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "required": ["id", "kind", "cppName"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "const": "ObjectReference" },
          "cppName": { "type": "string", "pattern": "^F[A-Za-z0-9_]+$" }
        }
      }
    },
    "apis": {
      "type": "array", "minItems": 2, "maxItems": 1024,
      "items": {
        "type": "object",
        "required": ["id", "name", "displayName", "shape", "scope", "thread", "failureRule", "permissions", "signatureHash", "projectionHash", "native"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "$ref": "#/$defs/identifier" },
          "displayName": { "type": "string", "minLength": 1 },
          "shape": { "enum": ["ObjectGetter", "FloatMethod"] },
          "scope": { "enum": ["Player", "World"] },
          "thread": { "const": "GameThread" },
          "failureRule": { "const": "ReturnError" },
          "permissions": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "signatureHash": { "$ref": "#/$defs/hash" },
          "projectionHash": { "$ref": "#/$defs/hash" },
          "resultTypeId": { "type": "string", "minLength": 1 },
          "targetTypeId": { "type": "string", "minLength": 1 },
          "provider": { "const": "LocalPlayerSubsystem" },
          "nullResult": { "const": "Error" },
          "parameterName": { "$ref": "#/$defs/identifier" },
          "parameterId": { "type": "string", "minLength": 1 },
          "native": {
            "type": "object", "required": ["header", "symbol"],
            "properties": {
              "header": { "type": "string", "minLength": 1 },
              "symbol": { "$ref": "#/$defs/identifier" }
            }
          }
        },
        "allOf": [
          { "if": { "properties": { "shape": { "const": "ObjectGetter" } } }, "then": { "required": ["resultTypeId", "provider", "nullResult"], "properties": { "scope": { "const": "Player" } } } },
          { "if": { "properties": { "shape": { "const": "FloatMethod" } } }, "then": { "required": ["targetTypeId", "parameterName", "parameterId"] } }
        ]
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$" }
  }
}
