cmake_minimum_required(VERSION 3.20)

function(read_package key prefix)
    file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/LibClangPackages.txt" entry REGEX "^${key} ")
    if(NOT entry MATCHES "^[^ ]+ ([0-9a-f]+) (https://[^ ]+)$")
        message(FATAL_ERROR "Missing or invalid libclang package entry: ${key}")
    endif()
    set(${prefix}_hash "${CMAKE_MATCH_1}" PARENT_SCOPE)
    set(${prefix}_url "${CMAKE_MATCH_2}" PARENT_SCOPE)
endfunction()

function(download_package url hash archive)
    message(STATUS "Downloading ${url}")
    file(DOWNLOAD "${url}" "${archive}" EXPECTED_HASH "SHA256=${hash}"
        TLS_VERIFY ON TIMEOUT 300 INACTIVITY_TIMEOUT 45 STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "Could not download ${url}: ${status}")
    endif()
endfunction()

# Check the installed files as well as the download. A missing header or damaged
# library can then be repaired by running Setup again.
function(payload_hash root output)
    file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${root}"
        "${root}/bin/*" "${root}/lib/*" "${root}/licenses/*")
    set(inventory "")
    foreach(path IN LISTS files)
        file(SHA256 "${root}/${path}" hash)
        string(APPEND inventory "${hash}  ${path}\n")
    endforeach()
    string(SHA256 digest "${inventory}")
    set(${output} "${digest}" PARENT_SCOPE)
endfunction()

cmake_host_system_information(RESULT processor QUERY OS_PLATFORM)
string(TOLOWER "${processor}" processor)
if(processor MATCHES "^(amd64|x86_64|x64)$")
    set(arch x64)
elseif(processor MATCHES "^(arm64|aarch64)$")
    set(arch arm64)
endif()
if(NOT DEFINED arch OR NOT CMAKE_HOST_SYSTEM_NAME MATCHES "^(Windows|Linux|Darwin)$")
    message(STATUS "No bundled libclang for ${CMAKE_HOST_SYSTEM_NAME}/${processor}. Use a host LLVM installation for generation.")
    return()
endif()
set(host "${CMAKE_HOST_SYSTEM_NAME}-${arch}")
if(CMAKE_HOST_WIN32)
    set(library_dir bin)
    set(library libclang.dll)
elseif(CMAKE_HOST_APPLE)
    set(library_dir lib)
    set(library libclang.dylib)
else()
    set(library_dir lib)
    set(library libclang.so)
endif()

read_package("${host}" native)
read_package(headers headers)
string(SHA256 package_id "${native_hash}:${headers_hash}")
string(SUBSTRING "${package_id}" 0 16 package_id)
set(build "${CMAKE_CURRENT_LIST_DIR}/build")
get_filename_component(workspace "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
if(EXISTS "${workspace}/Setup/CMakePackages.txt")
    set(cache "${workspace}/.tools/libclang")
else()
    set(cache "${build}/LibClang")
endif()
set(install "${cache}/${host}-${package_id}")
file(MAKE_DIRECTORY "${cache}" "${build}")
file(LOCK "${cache}/.${host}.lock" GUARD PROCESS TIMEOUT 900)

if(EXISTS "${install}/.sha256")
    file(READ "${install}/.sha256" expected)
    payload_hash("${install}" actual)
endif()
if(NOT DEFINED actual OR NOT actual STREQUAL expected)
    set(stage "${install}.partial")
    file(REMOVE_RECURSE "${stage}")
    set(payload "${stage}/runtime")
    file(MAKE_DIRECTORY "${payload}/${library_dir}" "${payload}/lib/clang/21" "${payload}/licenses")
    download_package("${native_url}" "${native_hash}" "${stage}/native.whl")
    download_package("${headers_url}" "${headers_hash}" "${stage}/headers.deb")
    file(ARCHIVE_EXTRACT INPUT "${stage}/native.whl" DESTINATION "${stage}"
        PATTERNS "clang/native/${library}" "*.dist-info/licenses/LICENSE")
    file(RENAME "${stage}/clang/native/${library}" "${payload}/${library_dir}/${library}")
    file(GLOB license "${stage}/*.dist-info/licenses/LICENSE")
    file(RENAME "${license}" "${payload}/licenses/libclang-LICENSE")

    # The wheel omits generated target headers such as arm_neon.h. LLVM's
    # common development package contains the resource headers for all targets.
    set(include "usr/lib/llvm-21/lib/clang/21/include")
    set(copyright "usr/share/doc/libclang-common-21-dev/copyright")
    file(ARCHIVE_EXTRACT INPUT "${stage}/headers.deb" DESTINATION "${stage}" PATTERNS "data.tar.zst")
    file(ARCHIVE_EXTRACT INPUT "${stage}/data.tar.zst" DESTINATION "${stage}"
        PATTERNS "./${include}/*" "./${copyright}")
    file(RENAME "${stage}/${include}" "${payload}/lib/clang/21/include")
    file(RENAME "${stage}/${copyright}" "${payload}/licenses/clang-resource-headers-copyright")

    payload_hash("${payload}" actual)
    file(WRITE "${payload}/.sha256" "${actual}")
    # Keep the old directory intact if a running process prevents a repair.
    if(EXISTS "${install}")
        file(RENAME "${install}" "${stage}/previous")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E rename "${payload}" "${install}" RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
        if(EXISTS "${stage}/previous")
            file(RENAME "${stage}/previous" "${install}")
        endif()
        message(FATAL_ERROR "Could not publish the host libclang to ${install}")
    endif()
    file(REMOVE_RECURSE "${stage}")
endif()

# Keep the tool and cache relocatable together. Publish the path only after
# installation and preserve its timestamp when UHT would read the same file.
set(receipt "${build}/libclang-${host}.path")
file(RELATIVE_PATH relative "${build}" "${install}/${library_dir}/${library}")
if(EXISTS "${receipt}")
    file(READ "${receipt}" previous)
endif()
if(NOT "${previous}" STREQUAL "${relative}\n")
    file(WRITE "${receipt}.tmp" "${relative}\n")
    file(RENAME "${receipt}.tmp" "${receipt}")
endif()
message(STATUS "Host libclang is ready in ${install}")
