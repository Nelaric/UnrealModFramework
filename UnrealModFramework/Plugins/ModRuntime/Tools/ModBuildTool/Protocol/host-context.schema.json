{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UMF owning-module host compilation context v2",
  "type": "object",
  "dependentRequired": { "linkVerification": ["owningBinary"] },
  "required": ["format", "schemaVersion", "ownerModule", "moduleAPIMode", "registrationAnchor", "target", "workingDirectory", "outputLibrary", "compiler", "archiver", "environment", "dependencies", "lto", "pch", "unity"],
  "properties": {
    "format": { "const": "UMF.ModHostContext" },
    "schemaVersion": { "const": 2 },
    "ownerModule": { "type": "string", "minLength": 1 },
    "moduleAPIMode": { "const": "Producer" },
    "registrationAnchor": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "owningBinary": {
      "type": "object",
      "required": ["id", "path", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["Executable", "DynamicLibrary"] }
      }
    },
    "linkVerification": {
      "const": "PeExportV1",
      "description": "Compile a unique PE export into the host registration unit and require it in the linked image."
    },
    "lto": { "const": false },
    "pch": { "const": false },
    "unity": { "const": false },
    "target": {
      "type": "object",
      "required": ["name", "type", "configuration", "linkType", "platform", "architecture"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["Game", "Editor", "Client", "Server", "Program"] },
        "configuration": { "enum": ["Debug", "DebugGame", "Development", "Shipping", "Test"] },
        "linkType": { "enum": ["Modular", "Monolithic"] },
        "platform": { "enum": ["Win64", "Linux", "Mac"] },
        "architecture": { "enum": ["x64", "arm64"] }
      }
    },
    "workingDirectory": { "type": "string", "minLength": 1 },
    "outputLibrary": { "type": "string", "minLength": 1 },
    "compiler": {
      "allOf": [{ "$ref": "#/$defs/tool" }],
      "required": ["dependencyFormat"],
      "properties": { "dependencyFormat": { "enum": ["msvc-json", "make"] } }
    },
    "archiver": { "$ref": "#/$defs/tool" },
    "environmentMode": {
      "enum": ["Explicit", "Inherit"],
      "default": "Inherit",
      "description": "Explicit runs tools with the environment object. Inherit applies it to the caller's environment."
    },
    "environment": { "type": "object", "additionalProperties": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["path", "arguments", "responseFormat"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "arguments": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "responseFormat": { "enum": ["msvc", "gnu"] }
      }
    }
  }
}
