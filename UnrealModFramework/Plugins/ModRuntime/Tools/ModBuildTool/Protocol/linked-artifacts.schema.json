{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UMF verified host build and link association v2",
  "type": "object",
  "required": ["format", "schemaVersion", "status", "ownerModule", "target", "contextHash", "generationId", "inputFingerprint", "contractHash", "projectionHash", "nativeABIHash", "library", "libraryHash", "binary", "hostBuildReceipt", "linkReceipt", "requiredSymbols", "publicArtifacts"],
  "properties": {
    "format": { "const": "UMF.ModHostLinkedArtifacts" },
    "schemaVersion": { "const": 2 },
    "status": { "const": "Linked" },
    "ownerModule": { "type": "string", "minLength": 1 },
    "target": { "$ref": "host-context.schema.json#/properties/target" },
    "contextHash": { "$ref": "#/$defs/hash" },
    "generationId": { "$ref": "#/$defs/hash" },
    "inputFingerprint": { "$ref": "#/$defs/hash" },
    "contractHash": { "$ref": "#/$defs/hash" },
    "projectionHash": { "$ref": "#/$defs/hash" },
    "nativeABIHash": { "$ref": "#/$defs/hash" },
    "library": { "type": "string", "minLength": 1 },
    "libraryHash": { "$ref": "#/$defs/hash" },
    "binary": { "$ref": "host-link-receipt.schema.json#/properties/binary" },
    "hostBuildReceipt": { "$ref": "#/$defs/file" },
    "linkReceipt": { "$ref": "#/$defs/file" },
    "requiredSymbols": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "publicArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourcePath", "relativePath", "contentHash", "ownerModule", "role"],
        "properties": {
          "sourcePath": { "type": "string", "minLength": 1 },
          "relativePath": { "type": "string", "minLength": 1 },
          "contentHash": { "$ref": "#/$defs/hash" },
          "ownerModule": { "type": ["string", "null"] },
          "role": { "enum": ["SdkHeader", "Contract", "SdkResource"] }
        }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "file": {
      "type": "object",
      "required": ["path", "contentHash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "contentHash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
